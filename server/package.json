{
  "name": "@saladbowl/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch --import tsx src/index.ts",
    "build": "esbuild src/index.ts src/cli/hash-password.ts --bundle --platform=node --format=esm --target=node24 --packages=external --alias:@saladbowl/shared=../shared/src/index.ts --outdir=dist --entry-names=[name]",
    "start": "node dist/index.js",
    "hash-password": "tsx src/cli/hash-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.3.7",
    "@saladbowl/shared": "*",
    "fastify": "^5.12.8",
    "ws": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}